<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ouora Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>Quora Posts</h1>
        <hr>
        
        <% for(let post of posts){ %>
            <div class="postings">
                <div class="post-author"><%= post.username %></div>
                <div class="post-content"><%= post.content %></div>
                
                <div class="post-actions">
                    <a href="/posts/<%= post.id %>">View Details</a>
                    <a href="/posts/<%= post.id %>/edit">Edit</a>
                    <form method="post" action="/posts/<%= post.id %>?_method=DELETE" style="display:inline;">
                        <button class="btn-delete">Delete</button>
                    </form>
                </div>
            </div>
        <% } %>
        
        <div class="btn-create-container">
            <a href="/posts/new" class="btn-create">✏️ Create New Post</a>
        </div>
    </div>
</body>
</html>